# sliceworks 0.8.1: project configuration, sourced by the hooks (POSIX sh) and read by the scripts.
# Flat KEY=value lines only; paths are relative to the repository root. Fill every TODO.
SW_PLUGIN_HOOKS=on                  # on | off: off disables package enforcement hooks when project hooks own enforcement
SW_PROFILE=full                      # lite | full | dual
SW_PHASES="spark discover decide design plan build accept release operate learn"   # phases this project runs (a library may drop spark/operate)
SW_STATE_DIR=docs/process            # state files: FEATURES.json, STATE.md, BACKLOG.md, PROGRESS.md, OWNER-DECISIONS.md, NEEDS-HUMAN.md, INVARIANTS.md, START.md, slices/, contracts/, retros/, metrics/, demos/
SW_OUTPUTS_DIR=outputs               # verification logs: <outputs>/slices/<slice>/<tier>-<ts>.log
SW_RUN_DIR=.run                      # session recovery file, guard denials, caches (gitignored)
SW_INTEGRATION_BRANCH=main           # the one branch the coordinator merges into
SW_SLICE_BRANCH_PREFIX=slice/        # slice branches: <prefix><slice>
SW_WORKTREE_ROOT=.claude/worktrees   # where the host creates implementer worktrees
SW_INIT_CMD=TODO                     # brings a checkout or worktree to the baseline, e.g. scripts/dev/init.sh; must accept --smoke
SW_VERIFY_CMD=scripts/dev/verify-slice.sh   # the tier runner; called with t0 | t1 | t2 | t3; prints RESULT= and LOG=
SW_T0_ARGS=t0
SW_PREHANDOFF_CMD=""                # empty = SW_VERIFY_CMD + SW_T0_ARGS; lint + all database-free tests for changed packages
SW_DEMO_CMD=TODO                     # runs an increment's exit demo: <cmd> <n>
SW_PROTECTED_EXTRA=""                # space-separated paths only the coordinator writes, beyond the state files, agent guides, .claude/ and .sliceworks/ (e.g. docs/adr/ the constitution)
SW_CONTRACT_SURFACES=""              # space-separated path prefixes the contract author may write (e.g. api/openapi.yaml specs/ testdata/contracts/)
SW_MATERIAL_SURFACES="access-control isolation erasure private-data grounding money"   # first implementations that trigger the named-risk review
SW_WEEKLY_DISPATCH_HOLD=80           # percent of the weekly window: no new dispatch at or above
SW_WEEKLY_STOP=85                    # running implementers stop at or above; the owner keeps the rest
SW_FIVE_HOUR_DISPATCH_HOLD=90
SW_FIVE_HOUR_STOP=100
SW_OWNER_SHARE_PCT=15
SW_READING_MAX_AGE=5400              # seconds a usage reading stays valid for dispatch
SW_CLAUDE_READING_MINUTES=15         # claude-usage-statusline.py: write an unchanged Claude reading at most this often
SW_WRITER_CAP=3                      # concurrent implementers (on Codex, live writer processes of dispatch.sh)
SW_CODEX_MODEL=""                    # Codex model for the agents whose Claude profile names sonnet or haiku; empty = inherit
SW_CODEX_MODEL_STRONG=""             # Codex model for the opus and fable profiles (architect, contract author, named-risk reviewer); empty = inherit
SW_CODEX_BIN=codex                  # executable on PATH or absolute CLI path (macOS: the CLI bundled in ChatGPT.app)
SW_CODEX_NETWORK=0                   # only 0 is supported; database gates use the host gate-runner; 1/local are refused
SW_CODEX_EXEC_ARGS=""                # non-security extra flags, space-separated; sandbox/network overrides are refused
SW_CODEX_CONTINUE=1                  # Codex coordinator: the Stop hook continues the turn while worker processes run or have finished unread
SW_STALL_MINUTES=20                  # idle minutes before a STALL line
SW_TURN_LIMIT=250                    # maxTurns per implementer dispatch
SW_EXPLORER_AGENTS="Explore Plan claude-code-guide code-explorer sliceworks:code-explorer"   # exempt from the budget guard
SW_DISPATCH_TOOLS="Agent SendMessage send_message"   # tool names or substrings that wake a worker: every one is a dispatch for the budget holds
SW_INFRA_DENY="kubectl| helm |terraform| yc |ansible|docker push|docker rm|docker stop"      # |-separated substrings implementers may never run
SW_TIMEZONE=UTC                      # display time zone for status and dashboard: UTC, an IANA name (Europe/Istanbul) or an offset (+03:00)
SW_PROJECT_NAME=""                   # dashboard title; empty = the README's first heading, else the directory name
SW_DASHBOARD_OUT=""                  # dashboard page; empty = <state-dir>/dashboard.html (gitignore it)
SW_DASHBOARD_LINK_BASE=""            # optional URL of the repository root for file links on the page (e.g. https://github.com/o/r/blob/main/); empty = paths relative to the page
SW_DASHBOARD_PUBLISH_CMD=""          # optional command the dashboard loop runs to publish the page (an upload script of the project); empty = local only
SW_DASHBOARD_PUBLISH_EVERY=900      # seconds between publications
SW_HUMAN_ONLY_EXTRA=""               # additions to the human-only list of method 10, one phrase each, ;-separated
SW_ROUNDS_DIR=docs/process/rounds    # research rounds; a round with a .closed marker is frozen
SW_DESIGN_SURFACES="docs/process/ARCHITECTURE.md docs/process/INVARIANTS.md docs/process/SCENARIOS.json docs/process/MILESTONES.md docs/process/threat-models/ specs/"   # what the architect may write
SW_ENVIRONMENTS="isolated staging production"   # agents deploy only to the first; the rest are human acts
SW_REVIEW_LIMIT_DAYS=30              # INDEX.md rows older than this fail the design-doc lint
SW_MONEY_FILE=docs/process/metrics/money.jsonl
SW_MONEY_CAP=0                       # total authorized spend in SW_MONEY_CURRENCY; 0 = no paid runs allowed
SW_MONEY_CURRENCY=USD
SW_PAID_CMDS=""                      # |-separated substrings of commands that cost money (e.g. "evals/run.sh|--model=paid"); the money guard checks the ledger first
